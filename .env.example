# Hugging Face token with Inference Providers permission.
# Keep the real token in Vercel/your local environment, never in Git.
HF_TOKEN=hf_your_token_here

# Tiny Mentor model used by the current chat integration.
# Qwen3-0.6B is the current default; it is small enough for a lightweight Mentor role.
# Provider availability and free-tier limits can change.
ORI_MENTOR_MODEL=Qwen/Qwen3-0.6B
