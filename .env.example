# Hugging Face token with Inference Providers permission.
# Keep the real token in Vercel/your local environment, never in Git.
HF_TOKEN=hf_your_token_here

# Current Mentor model used by chat and robotics planning/perception.
HF_MODEL=Qwen/Qwen3-0.6B

# Robotics API authentication. Generate a strong random secret and store it only in Vercel/local secrets.
ORI_ROBOTICS_API_KEY=replace_with_a_long_random_secret

# Explicit robotics operating mode. Default is disconnected; mock is never treated as real hardware.
ORI_ROBOTICS_MODE=disconnected

# Optional physical robot identifier.
ORI_ROBOT_ID=ori-robot-01
