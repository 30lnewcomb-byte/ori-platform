# Ori Platform server-side configuration
# Never commit real secrets. These values are read only by server-side code.
ORI_INTELLIGENCE_URL=https://your-ori-intelligence-service.example
ORI_INTELLIGENCE_API_KEY=replace_with_a_long_random_secret

# Render-hosted Ori VM runtime, accessed only by server-side platform code.
ORI_VM_URL=https://ori-vm-runtime.onrender.com
ORI_VM_API_KEY=replace_with_a_long_random_secret

# Robotics API authentication.
ORI_ROBOTICS_API_KEY=replace_with_a_long_random_secret

# Explicit robotics operating mode.
ORI_ROBOTICS_MODE=disconnected

# Optional physical robot identifier.
ORI_ROBOT_ID=ori-robot-01
