# Hugging Face token with Inference Providers permission.
# Keep the real token in Vercel/your local environment, never in Git.
HF_TOKEN=hf_your_token_here

# Mentor model used by the current chat integration.
# Example documented by Hugging Face: google/gemma-2-2b-it
ORI_MENTOR_MODEL=google/gemma-2-2b-it:fastest
